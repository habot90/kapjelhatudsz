{
  // Csak a helyi fejlesztői D1 migrációkhoz (npm run db:migrate:local).
  // Az élő Sites/Cloudflare környezet NEM ebből a fájlból kapja a kötéseit;
  // a database_id és a binding szándékosan egyezik a vite.config.ts-ben lévővel,
  // hogy ugyanazt a helyi Miniflare-adatbázist érje el.
  "name": "kapjelhatudsz-local-d1",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../drizzle"
    }
  ]
}
